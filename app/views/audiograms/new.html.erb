<div class="container mt-5">

  <div class="mb-3">
    <%= link_to audiograms_path, class: "text-decoration-none text-muted fw-bold" do %>
      <i class="bi bi-arrow-left me-1"></i> Back to History
    <% end %>
  </div>

  <div class="text-center mb-5">
    <h2 class="fw-bold">New Hearing Assessment</h2>
    <p class="text-muted">Choose how you want to input your data</p>
  </div>

  <div class="card shadow-sm">
    <div class="card-header bg-white">
      <ul class="nav nav-tabs card-header-tabs" id="inputMethodTab" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="manual-tab" data-bs-toggle="tab" data-bs-target="#manual" type="button" role="tab" aria-controls="manual" aria-selected="true">
            <i class="bi bi-grid-3x3 me-2"></i>Manual Input
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="upload-tab" data-bs-toggle="tab" data-bs-target="#upload" type="button" role="tab" aria-controls="upload" aria-selected="false">
            <i class="bi bi-camera me-2"></i>Upload Image (AI)
          </button>
        </li>
      </ul>
    </div>

    <div class="card-body p-4">
      <div class="tab-content" id="inputMethodTabContent">

        <div class="tab-pane fade show active" id="manual" role="tabpanel" aria-labelledby="manual-tab">
          <%= form_with model: @audiogram, local: true, data:{ turbo: false} do |f| %>
            <div class="alert alert-info border-0 d-flex align-items-center mb-4">
              <div class="me-2">ℹ️</div>
              <div>Enter the threshold (dB) for each frequency. Negative numbers (e.g. -10) are allowed.</div>
            </div>

            <div class="table-responsive">
              <table class="table table-bordered text-center align-middle">
                <thead class="table-light">
                <tr>
                  <th class="py-3">Frequency (Hz)</th>
                  <th>125</th>
                  <th>250</th>
                  <th>500</th>
                  <th>1000</th>
                  <th>2000</th>
                  <th>4000</th>
                  <th>8000</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                  <td class="fw-bold text-primary bg-light">Left Ear (Blue X)</td>
                  <% ["125", "250", "500", "1000", "2000", "4000", "8000"].each do |freq| %>
                    <td>
                      <input type="number" name="audiogram[left_ear][<%= freq %>]" class="form-control text-center fw-bold text-primary" min="-20" max="120" required>
                    </td>
                  <% end %>
                </tr>

                <tr>
                  <td class="fw-bold text-danger bg-light">Right Ear (Red O)</td>
                  <% ["125", "250", "500", "1000", "2000", "4000", "8000"].each do |freq| %>
                    <td>
                      <input type="number" name="audiogram[right_ear][<%= freq %>]" class="form-control text-center fw-bold text-danger" min="-20" max="120" required>
                    </td>
                  <% end %>
                </tr>
                </tbody>
              </table>
            </div>

            <div class="d-grid gap-2 mt-4">
              <%= f.submit "Analyze Manual Data", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>
        </div>

        <div class="tab-pane fade" id="upload" role="tabpanel" aria-labelledby="upload-tab">
          <%= form_with model: @audiogram, local: true, multipart: true, multipart: true, data: {turbo: false} do |f| %>

            <div class="text-center py-5">
              <div class="mb-4">
                <img src="https://cdn-icons-png.flaticon.com/512/337/337946.png" alt="Upload Icon" style="width: 80px; opacity: 0.6;">
              </div>

              <h5 class="mb-3">Upload a clear photo of your audiogram</h5>
              <p class="text-muted mb-4" style="max-width: 400px; margin: 0 auto;">
                Our AI will automatically identify the X (Left) and O (Right) markers on your chart.
              </p>

              <div class="row justify-content-center">
                <div class="col-md-6">
                  <%= f.file_field :image_file, class: "form-control form-control-lg mb-4", accept: "image/*", required: true %>

                  <div class="d-grid">
                    <%= f.submit "🚀 Upload & Analyze with AI", class: "btn btn-success btn-lg" %>
                  </div>
                </div>
              </div>

              <div class="mt-4 text-muted small">
                Supported formats: JPG, PNG, JPEG
              </div>
            </div>

          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>