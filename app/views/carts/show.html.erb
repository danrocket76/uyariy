<div class="container mt-5">
  <h2 class="mb-4">Shopping Cart</h2>

  <% if @cart.order_items.any? %>
    <table class="table align-middle">
      <thead>
      <tr>
        <th>Product</th>
        <th>Price</th>
        <th>Qty</th>
        <th>Total</th>
        <th>Action</th>
      </tr>
      </thead>
      <tbody>
      <% @cart.order_items.each do |item| %>
        <tr>
          <td>
            <h5 class="mb-0"><%= item.hearing_aid.device_model %></h5>
            <small class="text-muted"><%= item.hearing_aid.brand %></small>
          </td>
          <td><%= number_to_currency(item.hearing_aid.price) %></td>
          <td><%= item.quantity %></td>
          <td><%= number_to_currency(item.total_price) %></td>
          <td>
            <%= button_to "Remove", order_item_path(item), method: :delete, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
      </tbody>
      <tfoot>
      <tr class="table-light">
        <td colspan="3" class="text-end fw-bold">Total:</td>
        <td class="fw-bold"><%= number_to_currency(@cart.total_price) %></td>
        <td></td>
      </tr>
      </tfoot>
    </table>

    <div class="text-end mt-4">
      <%= button_to "Pay with Stripe", checkouts_path(cart_id: @cart.id), class: "btn btn-success btn-lg", data: {turbo: false} %>
    </div>
  <% else %>
    <div class="alert alert-info">Your cart is empty.</div>
  <% end %>
</div>