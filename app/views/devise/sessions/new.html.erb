<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh; background-color: #f8f9fa;">
  <div class="card shadow-sm border-0 p-4" style="width: 100%; max-width: 450px; border-radius: 12px;">

    <div class="card-body text-center">
      <h2 class="fw-bold mb-1" style="color: #2c3e50;">🦻 UYARIY</h2>
      <p class="text-muted small mb-4">CLINIC & STORE</p>

      <h3 class="text-start fw-bold mb-2">Sign in</h3>
      <p class="text-start text-muted mb-4">Choose how you'd like to sign in</p>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <div class="form-floating mb-3">
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", id: "floatingInput", placeholder: "name@example.com" %>
          <label for="floatingInput">Email address</label>
        </div>

        <div class="form-floating mb-4">
          <%= f.password_field :password, autocomplete: "current-password", class: "form-control", id: "floatingPassword", placeholder: "Password" %>
          <label for="floatingPassword">Password</label>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-check text-start mb-3">
            <%= f.check_box :remember_me, class: "form-check-input" %>
            <%= f.label :remember_me, class: "form-check-label text-muted" %>
          </div>
        <% end %>

        <div class="d-grid gap-2">
          <%= f.submit "Continue", class: "btn btn-primary btn-lg", style: "background-color: #4a47a3; border: none;" %>
        </div>
      <% end %>

      <div class="mt-4 pt-3 border-top">
        <p class="text-muted small">
          Don't have an account?
          <%= link_to "Sign up", new_user_registration_path, class: "text-decoration-none fw-bold", style: "color: #e91e63;", data: {turbo: false} %>
        </p>
      </div>

    </div>
  </div>
</div>