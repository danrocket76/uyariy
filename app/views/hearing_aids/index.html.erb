<div class="container mt-5">
  <div class="text-center mb-5">
    <h1 class="fw-bold display-5">Hearing Aid Store</h1>
    <p class="text-muted lead">Browse our catalog of premium hearing devices.</p>
  </div>

  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% @hearing_aids.each do |aid| %>
      <div class="col">
        <div class="card h-100 shadow-sm border-0 transition-hover">

          <div class="bg-light d-flex align-items-center justify-content-center" style="height: 250px; overflow: hidden;">
            <% if aid.image_url.present? %>
              <%= image_tag aid.image_url, class: "img-fluid", style: "height: 100%; width: 100%; object-fit: contain; padding: 20px;" %>
            <% else %>
              <i class="bi bi-ear text-muted" style="font-size: 3rem;"></i>
            <% end %>
          </div>

          <div class="card-body d-flex flex-column">
            <small class="text-uppercase text-muted fw-bold mb-1"><%= aid.brand %></small>
            <h5 class="card-title fw-bold mb-3"><%= aid.device_model %></h5>

            <div class="mt-auto">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="h5 fw-bold text-success mb-0"><%= number_to_currency(aid.price) %></span>
                <% if aid.stock > 0 %>
                  <span class="badge bg-success-subtle text-success border border-success">In Stock</span>
                <% end %>
              </div>

              <div class="d-grid">
                <%= link_to "View Details", hearing_aid_path(aid), class: "btn btn-outline-dark" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>