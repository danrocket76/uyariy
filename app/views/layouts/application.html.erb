<!DOCTYPE html>
<html>
<head>
  <title>UYARIY</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
      <%= image_tag "logo.png", height: "45", class: "me-2", alt: "Uyariy Logo", onerror: "this.style.display='none'" %>
      <span style="font-size: 1.5rem; letter-spacing: 1px;">UYARIY</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto align-items-center">

        <li class="nav-item dropdown ms-3">
          <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-globe me-1"></i> <%= I18n.locale.to_s.upcase %>
          </a>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
            <li><%= link_to "🇺🇸 English", url_for(lang: 'en'), class: "dropdown-item" %></li>
            <li><%= link_to "🇪🇸 Español", url_for(lang: 'es'), class: "dropdown-item" %></li>
          </ul>
        </li>


        <li class="nav-item">
          <%= link_to t('navbar.store'), hearing_aids_path, class: "nav-link" %>
        </li>

        <% if user_signed_in? %>

          <% if current_user.admin? || current_user.audiologist? %>
            <li class="nav-item ms-2">
              <% if current_user.admin? %>
                <%= link_to t('navbar.dashboard'), admin_dashboard_path, class: "btn btn-warning btn-sm fw-bold text-dark" %>
              <% else %>
                <%= link_to t('navbar.clinic_panel'), admin_audiograms_path, class: "btn btn-warning btn-sm fw-bold text-dark" %>
              <% end %>
            </li>
            <li class="nav-item ms-3">
              <%= button_to t('navbar.logout'), destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
            </li>

          <% else %>
            <li class="nav-item">
              <%= link_to t('navbar.history'), audiograms_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to t('navbar.appointments'), appointments_path, class: "nav-link" %>
            </li>

            <li class="nav-item me-2 ms-2">
              <%= link_to cart_path(@cart), class: "nav-link position-relative" do %>
                <i class="bi bi-cart-fill" style="font-size: 1.2rem;"></i>
                <% if @cart && @cart.order_items.sum(:quantity) > 0 %>
                      <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.7em;">
                        <%= @cart.order_items.sum(:quantity) %>
                      </span>
                <% end %>
              <% end %>
            </li>

            <li class="nav-item ms-3">
              <%= button_to t('navbar.logout'), destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm" %>
            </li>
          <% end %>

        <% else %>
          <li class="nav-item">
            <%= link_to t('navbar.login'), new_user_session_path, class: "nav-link fw-bold" %>
          </li>
          <li class="nav-item ms-2">
            <%= link_to t('navbar.signup'), new_user_registration_path, class: "btn btn-outline-light btn-sm" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

<div class="container">
  <% flash.each do |key, value| %>
    <% alert_class = key == 'notice' ? 'success' : 'danger' %>
    <div class="alert alert-<%= alert_class %> alert-dismissible fade show shadow-sm" role="alert">
      <%= value %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>
  <%= yield %>
</div>

<div class="mt-auto py-4"></div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>